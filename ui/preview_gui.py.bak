        self._apply_init_from_config()
        self._on_preview_mode_change()

    def _on_preview_mode_change(self):
        mode = str(self.preview_mode_var.get() or "Operator mode")
        show_tuning = (mode == "Camera tuning mode")
        for role, box in list(self._tuning_boxes.items()):
            try:
                if show_tuning:
                    if not box.winfo_manager():
                        box.pack(**getattr(box, "_pack_cfg", {"fill": "x", "padx": 10, "pady": (4, 8)}))
                else:
                    if box.winfo_manager():
                        box.pack_forget()
            except Exception:
                pass



    def _safe_after(self, delay_ms, callback):
        if self._closing:
            return None
        try:
            if not self.winfo_exists():
                return None
        except Exception:
            return None

        after_id = None

        def wrapped():
            if after_id is not None:
                self._after_ids.discard(after_id)
            if self._closing:
                return
            try:
                if not self.winfo_exists():
                    return
            except Exception:
                return
            callback()

        try:
            after_id = self.after(delay_ms, wrapped)
            self._after_ids.add(after_id)
            return after_id
        except Exception:
            return None

    def _bandwidth_watchdog(self):
        if self._closing or not self.winfo_exists():
            return

        now = time.time()
        stale_after = 1.2  # sekundy bez update -> uznaj za 0/rozĹ‚Ä…czone

        # odczyt statusĂłw kamer (jeĹ›li masz)
        cam_status = {}
        if self.shared_state is not None:
            try:
                cam_status = self.shared_state.get("cam_status", {}) or {}
            except Exception:
                cam_status = {}

        for role in self.roles:
            status = cam_status.get(role, "ok")
            last = self._bw_last_time.get(role, 0.0)

            # jeĹ›li kamera nie-ok -> mrugaj i ustaw 0
            if status != "ok":
                self._bandwidth[role] = (0.0, 0.0)
                self._refresh_info_label(role)  # odpali _update_blink_condition -> mruganie
                continue

            # jeĹ›li ok, ale bandwidth nie odĹ›wieĹĽa się -> teĹĽ traktuj jak 0
            if last > 0.0 and (now - last) > stale_after:
                self._bandwidth[role] = (0.0, 0.0)
                self._refresh_info_label(role)

        self._safe_after(250, self._bandwidth_watchdog)


    # ---------------------- init z configu -------------------------
    def _get_initial_for_role(self, role: str):
        cfg = self.initial_settings or {}
        per_role = cfg.get("per_role", {}) or {}
        role_cfg = per_role.get(role, {}) or {}
        exp = role_cfg.get("exposure")
        gain = role_cfg.get("gain")
        if exp is None:
            exp = cfg.get("exposure_val")
        if gain is None:
            gain = cfg.get("gain_val")
        try:
            exp = float(exp) if exp is not None else None
        except Exception:
            exp = None
        try:
            gain = float(gain) if gain is not None else None
        except Exception:
            gain = None
        return exp, gain

    def _apply_init_from_config(self):
        for r, s in (self.sliders or {}).items():
            exp, gain = self._get_initial_for_role(r)

            if exp is not None and "exp_slider" in s and "exp_val" in s:
                s["exp_slider"].set(float(exp))
                s["exp_val"].configure(text=f"{int(float(exp))} Âµs")
                if "exp_entry" in s:
                    s["exp_entry"].delete(0, "end")
                    s["exp_entry"].insert(0, f"{int(float(exp))}")

            if gain is not None and "gain_slider" in s and "gain_val" in s:
                s["gain_slider"].set(float(gain))
                s["gain_val"].configure(text=f"{float(gain):.1f} dB")
                if "gain_entry" in s:
                    s["gain_entry"].delete(0, "end")
                    s["gain_entry"].insert(0, f"{float(gain):.1f}")

    # --------------------- kontrolki exp/gain ----------------------
    def _apply_from_entry(self, role: str, kind: str, entry):
        try:
            txt = entry.get().strip().replace(",", ".")
            if not txt:
                return
            val = float(txt)
        except Exception:
            return

        if kind == "exp":
            val = max(100.0, min(20000.0, val))
            s = self.sliders.get(role, {})
            if s.get("exp_slider"):
                s["exp_slider"].set(val)
            self.on_expo_change(val, role)
        elif kind == "gain":
            val = max(0.0, min(24.0, val))
            s = self.sliders.get(role, {})
            if s.get("gain_slider"):
                s["gain_slider"].set(val)
            self.on_gain_change(val, role)

    def on_expo_change(self, value, role):
        try:
            v = float(value)
        except Exception:
            return
        s = self.sliders.get(role, {})
        if s and "exp_val" in s:
            s["exp_val"].configure(text=f"{v:.0f} Âµs")
        if s and "exp_entry" in s:
            s["exp_entry"].delete(0, "end")
            s["exp_entry"].insert(0, f"{int(v)}")

        try:
            if self.control_q is not None:
                self.control_q.put(("exposure", (role, v)))
        except Exception as e:
            print(f"[PREVIEW][ERROR] on_expo_change({role}) â†’ {e}")

    def on_gain_change(self, value, role):
        try:
            v = float(value)
        except Exception:
            return
        s = self.sliders.get(role, {})
        if s and "gain_val" in s:
            s["gain_val"].configure(text=f"{v:.1f} dB")
        if s and "gain_entry" in s:
            s["gain_entry"].delete(0, "end")
            s["gain_entry"].insert(0, f"{v:.1f}")

        try:
            if self.control_q is not None:
                self.control_q.put(("gain", (role, v)))
        except Exception as e:
            print(f"[PREVIEW][ERROR] on_gain_change({role}) â†’ {e}")

    # --------------------- dokowanie okna --------------------------
    def _follow_main_window(self):
        if self._closing or not self.winfo_exists():
            return
        try:
            geom = None
            if self.shared_state is not None:
                geom = self.shared_state.get("main_window_geometry", None)
            if geom:
                x = geom.get("x", 100)
                y = geom.get("y", 100)
                w = geom.get("w", 800)
                h = geom.get("h", 600)

                width = max(900, int(w * 0.9))
                height = h
                new_x = x + w
                new_y = y
                self.geometry(f"{width}x{height}+{new_x}+{new_y}")
        except Exception:
            pass
        self._safe_after(200, self._follow_main_window)

    def _is_preview_active(self):
        """Zwraca True, jeĹ›li podglÄ…d jest wĹ‚Ä…czony w gĹ‚Ăłwnym GUI."""
        if self.shared_state is None:
            return True
        try:
            return bool(self.shared_state.get("preview_active", True))
        except Exception:
            return True


    # ------------------------ render -------------------------------
    # ------------------------ render -------------------------------
    def _render_to_label(self, label, frame_rgb):
        """Bezpieczne rysowanie ramki na CTkLabelu."""
        # okno/label juĹĽ nie istniejÄ… â†’ nic nie rĂłb
        try:
            if self._closing or not (self.winfo_exists() and label.winfo_exists()):
                return
        except Exception:
            return

        # sanity check â€“ 8-bit RGB
        if frame_rgb is None or not isinstance(frame_rgb, np.ndarray):
            return
        if frame_rgb.dtype != np.uint8 or frame_rgb.ndim != 3 or frame_rgb.shape[2] != 3:
            return

        h, w = frame_rgb.shape[:2]
        try:
            pil_img = Image.fromarray(frame_rgb)
            img = ctk.CTkImage(light_image=pil_img, dark_image=pil_img, size=(w, h))

            # helper pilnuje referencji
            set_ctk_image(label, img)
        except TclError as e:
            # tu Ĺ‚apiemy m.in. "image 'pyimageXXX' doesn't exist"
            print(f"[PREVIEW GUI] _render_to_label error: {e}")
            # ten label jest juĹĽ â€žpopsutyâ€ť â€“ odbuduj go dla tej roli
            try:
                for r, lab in self.camera_labels.items():
                    if lab is label:
                        self._rebuild_label_for_role(r)
                        break
            except Exception:
                pass
        except Exception as e:
            print(f"[PREVIEW GUI] _render_to_label unexpected error: {e}")

    def _poll_yolo_vis(self):
        if self._closing:
            return
        try:
            if not self.winfo_exists():
                return
        except Exception:
            return

        if self.yolo_vis_q is None:
            self._safe_after(30, self._poll_yolo_vis)
            return

        try:
            while True:
                msg = self.yolo_vis_q.get_nowait()
                if not isinstance(msg, dict):
                    continue

                centers = msg.get("latest_centers_by_role", {}) or {}
                for role, pt in centers.items():
                    if role in self.yolo_centers:
                        self.yolo_centers[role] = pt
        except queue.Empty:
            pass
        except Exception as e:
            print(f"[PREVIEW GUI] _poll_yolo_vis error: {e}")

        self._safe_after(30, self._poll_yolo_vis)

    def display_frame(self, role, frame):
        try:
            if not self._is_preview_active():
                return
            if self._closing or not self.winfo_exists():
                return

            if frame is None or not isinstance(frame, np.ndarray):
                return
            if frame.dtype != np.uint8 or frame.ndim != 3 or frame.shape[2] != 3:
                return

            label = self.camera_labels.get(role)
            if not label or not label.winfo_exists():
                return

            now = time.time()
            last = getattr(label, "_last_render", 0.0)
            if (now - last) < (1.0 / 15.0):
                return
            setattr(label, "_last_render", now)

            frame_to_draw = frame.copy()

            if bool(self.show_yolo_center_var.get()):
                pt = self.yolo_centers.get(role)
                if pt is not None:
                    try:
                        h, w = frame_to_draw.shape[:2]
                        src_w = float(pt.get("src_w", 1920.0) or 1920.0)
                        src_h = float(pt.get("src_h", 1080.0) or 1080.0)
                        px = float(pt.get("x", pt.get("center_x", 0.0)))
                        py = float(pt.get("y", pt.get("center_y", 0.0)))
                        cx = int(px * (w / max(1.0, src_w)))
                        cy = int(py * (h / max(1.0, src_h)))

                        cx = max(0, min(w - 1, cx))
                        cy = max(0, min(h - 1, cy))

                        import cv2
                        cv2.circle(frame_to_draw, (cx, cy), 6, (255, 0, 0), -1)
                        cv2.circle(frame_to_draw, (cx, cy), 12, (255, 255, 255), 2)
                    except Exception as e:
                        print(f"[PREVIEW GUI] point draw error for {role}: {e}")

            self._render_to_label(label, frame_to_draw)
            self.fullres_frames[role] = frame
            self._last_frame_time[role] = time.time()

        except Exception as e:
            print(f"[PREVIEW GUI] âťŚ Error displaying frame for {role}: {e}")


    def _rebuild_label_for_role(self, role: str):
        """Tworzy na nowo label z podglÄ…dem dla danej roli (gdy Tk mĂłwi 'pyimageX nie istnieje')."""
        container = self.preview_frames.get(role)
        if container is None:
            return
        try:
            if not container.winfo_exists():
                return
        except Exception:
            return

        # wyczyĹ›Ä‡ kontener
        for child in container.winfo_children():
            try:
                child.destroy()
            except Exception:
                pass

        # nowy label jak w _build_main_ui
        lbl = ctk.CTkLabel(
            container,
            text=f"{role}\nOczekiwanie na obraz...",
            fg_color="transparent",
            text_color=TEXT_DIM,
            font=(FONT_FAMILY, 12),
        )
        lbl.place(relx=0.5, rely=0.5, anchor="center", relwidth=0.95, relheight=0.95)

        # ponowne bindowanie zdarzeĹ„
        lbl.bind(
            "<Configure>",
            lambda e, r=role: (
                self.fullres_frames.get(r) is not None
                and self.display_frame(r, self.fullres_frames[r])
            ),
        )
        lbl.bind(
            "<Double-Button-1>",
            lambda e, r=role: self.on_preview_double_click(r),
        )

        self.camera_labels[role] = lbl
        # reset stanu ramek
        self.fullres_frames[role] = None
        self._last_frame_time[role] = 0.0
        lbl._last_status = None  # ĹĽeby _update_cam_status zadziaĹ‚aĹ‚ od nowa


    def _update_cam_status(self):
        """Aktualizuje tekst/placeholder na podglÄ…dach na podstawie shared_state['cam_status']."""
        if self._closing or not self.winfo_exists():
            return
        if not self._is_preview_active():
            for role, lbl in self.camera_labels.items():
                try:
                    lbl.configure(
                        text=f"{role}\nPodglÄ…d wyĹ‚Ä…czony",
                        image=None,
                        fg_color="#FFFFFF",  # biaĹ‚e tĹ‚o
                        text_color=TEXT_DIM,
                        font=(FONT_FAMILY, 12, "italic"),
                        justify="center",
                    )
                    lbl.image = None
                except Exception:
                    pass
                # czyĹ›cimy stan klatek
                self.fullres_frames[role] = None
                self._last_frame_time[role] = 0.0
                lbl._last_status = "preview_off"

            if self.winfo_exists():
                self._safe_after(300, self._update_cam_status)
            return

        # odczyt mapy statusĂłw z shared_state
        cam_status = {}
        if self.shared_state is not None:
            try:
                cam_status = self.shared_state.get("cam_status", {}) or {}
            except Exception:
                cam_status = {}

        for role, lbl in self.camera_labels.items():
            # label moĹĽe juĹĽ nie istnieÄ‡
            try:
                if not lbl.winfo_exists():
                    continue
            except Exception:
                continue

            status = cam_status.get(role, "ok")

            # jeĹ›li status się nie zmieniĹ‚, nic nie robimy
            prev = getattr(lbl, "_last_status", None)
            if prev == status:
                continue
            lbl._last_status = status

            # ----------------- STANY PROBLEMOWE -----------------
            if status in ("disconnected", "reconnecting", "error"):
                # sprĂłbuj uĹĽyÄ‡ konkretnego tekstu z watchdoga
                wd_msg = getattr(self, "_watchdog_msgs", {}).get(role, "")
                if wd_msg:
                    msg_text = wd_msg.replace("[WATCHDOG]", "").strip()
                else:
                    if status == "disconnected":
                        msg_text = "KAMERA ROZĹÄ„CZONA â€“ czekam na ponowne podĹ‚Ä…czenie."
                    elif status == "reconnecting":
                        msg_text = "Kamera rozĹ‚Ä…czona â€“ nawiÄ…zywanie poĹ‚Ä…czenia..."
                    else:
                        msg_text = "BĹÄ„D POĹÄ„CZENIA Z KAMERÄ„"

                msg = f"{role}\n{msg_text}"

                try:
                    if getattr(self, "no_signal_pil", None) is not None:
                        container = self.preview_frames.get(role, lbl)
                        container.update_idletasks()
                        cw = container.winfo_width() or self.no_signal_pil.width
                        ch = container.winfo_height() or self.no_signal_pil.height

                        cw_eff = int(cw * 0.95)
                        ch_eff = int(ch * 0.95)
                        iw, ih = self.no_signal_pil.size
                        scale = min(cw_eff / iw, ch_eff / ih)
                        tw = max(2, int(iw * scale))
                        th = max(2, int(ih * scale))

                        img_ctk = ctk.CTkImage(
                            light_image=self.no_signal_pil,
                            size=(tw, th),
                        )

                        lbl.configure(
                            image=img_ctk,
                            text=str(status),
                            compound="center",
                            fg_color="#FFFFFF",
                            font=(FONT_FAMILY, 14, "bold"),
                            text_color="brown",
                            justify="center",
                        )
                        lbl.image = img_ctk
                    else:
                        lbl.configure(
                            text=str(status),
                            image=None,
                            fg_color="#FFFFFF",
                            font=(FONT_FAMILY, 14, "bold"),
                            text_color=TEXT_DIM,
                            justify="center",
                        )
                        lbl.image = None
                except TclError as e:
                    print(f"[PREVIEW GUI] cam_status configure error ({role}): {e}")
                    # ten label jest popsuty -> stwĂłrz nowy
                    self._rebuild_label_for_role(role)
                    continue

                # przy wejĹ›ciu w stan problemowy zapominamy starÄ… klatkÄ™
                self._last_frame_time[role] = 0.0
                self.fullres_frames[role] = None
                continue

            # ----------------- POWRĂ“T DO OK -----------------
            if status == "ok":
                try:
                    # jeĹ›li jeszcze nie mamy ĹĽadnej klatki dla tej roli,
                    # pokaĹĽ komunikat "Oczekiwanie na obraz."
                    if self.fullres_frames.get(role) is None:
                        lbl.configure(
                            text=f"{role}\nOczekiwanie na obraz.",
                            image=None,
                            fg_color="#FFFFFF",
                            font=(FONT_FAMILY, 12),
                            text_color=TEXT_DIM,
                            justify="center",
                        )
                        lbl.image = None
                except TclError as e:
                    print(f"[PREVIEW GUI] cam_status reset error ({role}): {e}")
                    self._rebuild_label_for_role(role)
                    continue

                # po powrocie do OK liczymy klatki od nowa
                self._last_frame_time[role] = 0.0
                continue

        # zaplanuj kolejne odĹ›wieĹĽenie
        if self.winfo_exists():
            self._safe_after(300, self._update_cam_status)



    # ---------------------- podglÄ…d z kolejki ----------------------
    def update_frames(self):
        if self._closing or not self.winfo_exists():
            return
        if self.live_q is None:
            self._safe_after(500, self.update_frames)
            return

        # -------------------------------------------------
        # 1) SprawdĹş, czy podglÄ…d jest wĹ‚Ä…czony w main GUI
        # -------------------------------------------------
        preview_active = True
        if self.shared_state is not None:
            try:
                preview_active = bool(self.shared_state.get("preview_active", True))
            except Exception:
                preview_active = True

        target_fps = 12.0
        interval_ms = int(1000 / target_fps)

        # === PODGLÄ„D WYĹÄ„CZONY ===
        if not preview_active:
            # đź”ą nic nie czyĹ›cimy â€“ w oknie zostaje ostatnia klatka
            self._preview_active_last = False
            self._safe_after(interval_ms, self.update_frames)
            return

            # === PODGLÄ„D WĹÄ„CZONY ===
        if not self._preview_active_last:
            # dopiero co wĹ‚Ä…czony â†’ wyczyĹ›Ä‡ komunikaty z OFF
            for role, lbl in self.camera_labels.items():
                try:
                    lbl.configure(
                        text=f"{role}\nOczekiwanie na obraz.",
                        image=None,
                        fg_color="#FFFFFF",
                        text_color=TEXT_DIM,
                        font=(FONT_FAMILY, 12),
                    )
                except Exception:
                    pass
                self.fullres_frames[role] = None
                self._last_frame_time[role] = 0.0

        self._preview_active_last = True

        # -------------------------------------------------
        # 2) Normalna obsĹ‚uga klatek, tylko jeĹ›li preview ON
        # -------------------------------------------------
        frames_for_role = {}
        try:
            while True:
                item = self.live_q.get_nowait()
                if not (isinstance(item, (tuple, list)) and len(item) >= 2):
                    continue
                role = item[0]
                payload = item[1]
                ts_ns = item[2] if len(item) >= 3 else 0
                frames_for_role[role] = (payload, ts_ns)
        except queue.Empty:
            pass
        except Exception:
            pass

        for role, (payload, ts_ns) in frames_for_role.items():
            frame_rgb = None
            try:
                if isinstance(payload, str):
                    got = self.smm.read_frame(payload)
                    if got is not None:
                        frame_rgb, _ = got if isinstance(got, tuple) else (got, 0)
                elif isinstance(payload, np.ndarray):
                    frame_rgb = payload

                if frame_rgb is not None:
                    self.display_frame(role, frame_rgb)
            except Exception as e:
                print(f"[PREVIEW GUI] âš ď¸Ź decode/display error for {role}: {e}")

        # đź”ą wygaszanie starych ramek â†’ "Oczekiwanie na obraz."
        now = time.time()
        timeout = 1.5
        cam_status = {}
        if self.shared_state is not None:
            try:
                cam_status = self.shared_state.get("cam_status", {}) or {}
            except Exception:
                cam_status = {}

        for role, lbl in self.camera_labels.items():
            # jeĹ›li watchdog pokazaĹ‚ "KAMERA ROZĹÄ„CZONA" itp. â†’ nie nadpisujemy
            if cam_status.get(role, "ok") != "ok":
                continue

            last = self._last_frame_time.get(role, 0.0)
            if last == 0.0:
                continue
            if (now - last) > timeout:
                try:
                    lbl.configure(
                        text=f"{role}\nOczekiwanie na obraz.",
                        image=None,
                        fg_color="#FFFFFF",
                        text_color=TEXT_DIM,
                        font=(FONT_FAMILY, 12),
                    )
                    lbl.image = None
                except Exception:
                    pass
                self.fullres_frames[role] = None
                self._last_frame_time[role] = 0.0

        self._safe_after(interval_ms, self.update_frames)

    # -------------------------- zamkniÄ™cie -------------------------
    def on_close(self):
        self._closing = True

        for r in list(self._blink_jobs.keys()):
            self._stop_blink(r)

        for after_id in list(self._after_ids):
            try:
                self.after_cancel(after_id)
            except Exception:
                pass
        self._after_ids.clear()
        if self._imgsz_after_id is not None:
            try:
                self.after_cancel(self._imgsz_after_id)
            except Exception:
                pass
            self._imgsz_after_id = None

        try:
            if getattr(self, "control_q", None) is not None:
                self.control_q.put(("stop", True))
                print("[PREVIEW] âŹą wysĹ‚ano komendÄ™ STOP do control_q")
        except Exception as e:
            print(f"[PREVIEW] âš ď¸Ź bĹ‚Ä…d przy wysyĹ‚aniu STOP: {e}")

        try:
            if self.winfo_exists():
                self.destroy()
        except Exception:
            pass

    # ------------------------ statystyki ---------------------------
    def _update_stats(self):
        if self.stats_q is None:
            return

        try:
            while True:
                msg = self.stats_q.get_nowait()

                # đź”Ą tu odbierasz save_status z backendu
                if isinstance(msg, dict) and msg.get("type") == "save_status":
                    role = msg.get("role")
                    if role:
                        self._save_stats_buffer[role] = msg
                    continue

                if isinstance(msg, dict) and msg.get("type") == "camera_info":
                    role = msg.get("role", "?")
                    model = msg.get("model", "")
                    fw = msg.get("fw", "")
                    serial = msg.get("serial_number", "")

                    self._cam_info[role] = (model, fw, serial)
                    self._refresh_info_label(role)
                    continue

                # đź”Ą komunikaty tekstowe z watchdoga
                if isinstance(msg, str) and "[WATCHDOG]" in msg:
                    # sprĂłbuj wydĹ‚ubaÄ‡ rolÄ™ z tekstu, np. "Kamera CENTER_R (S/N ...)"
                    role = None
                    if "Kamera " in msg:
                        try:
                            frag = msg.split("Kamera ", 1)[1]
                            role = frag.split(" ", 1)[0].strip()
                        except Exception:
                            role = None
                    if role:
                        self._watchdog_msgs[role] = msg
                    # nie przerywamy, ale teĹĽ nie rzucamy wyjÄ…tkĂłw
                    continue
                # đź”Ą bandwidth z grabbera: fps + MB/s jak w Pylon Viewer
                if isinstance(msg, dict) and msg.get("type") == "bandwidth":
                    role = msg.get("role")
                    if role:
                        fps = msg.get("fps")
                        mbps = msg.get("pc_MBps")

                        # zapis do formatu, ktĂłrego uĹĽywa _refresh_info_label()
                        self._bandwidth[role] = (fps, mbps)

                        # zapamiÄ™taj czas ostatniego update (dla odĹ‚Ä…czenia)
                        self._bw_last_time[role] = time.time()

                        # odĹ›wieĹĽ tekst z ikonkami + miganie
                        self._refresh_info_label(role)
                    continue

                # inne rzeczy ignorujemy
        except queue.Empty:
            pass


        # đź”Ą odĹ›wieĹĽanie co 200 ms
        if self.winfo_exists():
            self._safe_after(200, self._update_stats)

    def _update_efficiency_bars(self):
        for role, msg in self._save_stats_buffer.items():
            saved = msg.get("saved", 0)
            expected = msg.get("expected", 1)
            backlog = msg.get("backlog", 0)

            ratio = saved / expected if expected > 0 else 0
            percent = int(ratio * 100)

            bar = self.eff_bars.get(role)
            lbl = self.eff_labels.get(role)

            if bar and lbl:
                bar.set(ratio)
                lbl.configure(text=f"Zapis: {percent}% ({saved}/{expected}) | b:{backlog}")

        # đź”Ą odĹ›wieĹĽanie co 300 ms (pĹ‚ynniej)
        if self.winfo_exists():
            self._safe_after(300, self._update_efficiency_bars)

    def _refresh_info_label(self, role: str):
        """SkĹ‚ada Ĺ‚adny tekst info (Styl 3) i ustawia go w info_label."""
        lbl = self.camera_info_labels.get(role)
        if lbl is None:
            return

        model, fw, serial = self._cam_info.get(role, ("", "", ""))
        fps, mbps = self._bandwidth.get(role, (None, None))

        line1_parts = []
        if model:
            line1_parts.append(f"đź“· {model}")
        if fw:
            line1_parts.append(f"FW {fw}")
        line1 = "  |  ".join(line1_parts) if line1_parts else "đź“· -"

        line2_parts = []
        if serial:
            line2_parts.append(f"đź”˘ S/N: {serial}")
        if fps is not None:
            line2_parts.append(f"đźŽž {float(fps):.1f} fps")
        if mbps is not None:
            line2_parts.append(f"đźš€ {float(mbps):.1f} MB/s")

        line2 = "   â€˘   ".join(line2_parts) if line2_parts else " "

        lbl.configure(text=f"{line1}\n{line2}")
        self._update_blink_condition(role, fps, mbps)

    # -------------------------- zamkniÄ™cie -------------------------


    def on_preview_double_click(self, role):
        if self.zoom_q is None:
            print("[PREVIEW] âš ď¸Ź Brak kolejki zoom_q.")
            return
        try:
            if self.control_q is not None:
                self.control_q.put(("set_zoom_role", role))
        except Exception as e:
            print(f"[PREVIEW] âš ď¸Ź bĹ‚Ä…d przy wysyĹ‚aniu set_zoom_role: {e}")

        import queue as _queue
        if self.zoom_q is None:
            self.zoom_q = _queue.Queue(maxsize=8)

        screen_w = self.winfo_screenwidth()
        screen_h = self.winfo_screenheight()
        max_w = int(screen_w * 0.8); max_h = int(screen_h * 0.8)

        if hasattr(self, "_zoom_windows") and role in getattr(self, "_zoom_windows", {}):
            win = self._zoom_windows[role]
            if win.winfo_exists():
                win.lift(); win.focus_force(); return
        else:
            self._zoom_windows = {}

        zoom_win = ctk.CTkToplevel(self)
        zoom_win.title(f"{role} - Zoom Preview")
        zoom_win.geometry(f"{max_w}x{max_h}")
        zoom_win.lift(); zoom_win.attributes("-topmost", True); zoom_win.focus_force()

        lbl = ctk.CTkLabel(zoom_win, text="âŹł czekam na klatkÄ™...")
        lbl.pack(fill="both", expand=True)
        zoom_win.update_idletasks()
        self._zoom_windows[role] = zoom_win

        zoom_factor = 1.0
        zoom_center = [0.5, 0.5]

        def apply_zoom(new_zoom, cx, cy):
            nonlocal zoom_factor, zoom_center
            new_zoom = max(1.0, min(float(new_zoom), 12.0))
            if new_zoom == zoom_factor:
                return
            scale = new_zoom / zoom_factor
            zoom_center[0] = cx + (zoom_center[0] - cx) / scale
            zoom_center[1] = cy + (zoom_center[1] - cy) / scale
            zoom_center[0] = min(max(zoom_center[0], 0.0), 1.0)
            zoom_center[1] = min(max(zoom_center[1], 0.0), 1.0)
            zoom_factor = new_zoom

        def on_mouse_click(event):
            if lbl.winfo_width() <= 0 or lbl.winfo_height() <= 0:
                return
            zoom_center[0] = event.x / max(1, lbl.winfo_width())
            zoom_center[1] = event.y / max(1, lbl.winfo_height())

        def on_wheel_win(event):
            if lbl.winfo_width() <= 0 or lbl.winfo_height() <= 0:
                return
            cx = event.x / max(1, lbl.winfo_width())
            cy = event.y / max(1, lbl.winfo_height())
            step = 0.12 if getattr(event, "delta", 0) > 0 else -0.12
            apply_zoom(zoom_factor + step, cx, cy)

        def on_wheel_up(event):
            cx = event.x / max(1, lbl.winfo_width())
            cy = event.y / max(1, lbl.winfo_height())
            apply_zoom(zoom_factor + 0.12, cx, cy)

        def on_wheel_down(event):
            cx = event.x / max(1, lbl.winfo_width())
            cy = event.y / max(1, lbl.winfo_height())
            apply_zoom(zoom_factor - 0.12, cx, cy)

        lbl.bind("<Button-1>", on_mouse_click)
        lbl.bind("<MouseWheel>", on_wheel_win)  # Win/macOS
        lbl.bind("<Button-4>", on_wheel_up)    # Linux
        lbl.bind("<Button-5>", on_wheel_down)  # Linux

        def reset_zoom(_e=None):
            nonlocal zoom_factor, zoom_center
            zoom_factor = 1.0; zoom_center[:] = [0.5, 0.5]
        lbl.bind("<Double-Button-1>", reset_zoom)

        def render_zoom(frame_rgb):
            try:
                import cv2
                h, w = frame_rgb.shape[:2]
                cx = int(zoom_center[0] * w); cy = int(zoom_center[1] * h)
                half_w = max(1, int(w / (2.0 * zoom_factor)))
                half_h = max(1, int(h / (2.0 * zoom_factor)))
                x1, y1 = max(0, cx - half_w), max(0, cy - half_h)
                x2, y2 = min(w, cx + half_w), min(h, cy + half_h)
                if x2 <= x1 or y2 <= y1:
                    return None
                crop = frame_rgb[y1:y2, x1:x2]
                tw, th = max(2, lbl.winfo_width()), max(2, lbl.winfo_height())
                if crop.shape[1] != tw or crop.shape[0] != th:
                    interp = cv2.INTER_AREA if (crop.shape[1] >= tw and crop.shape[0] >= th) else cv2.INTER_LINEAR
                    crop = cv2.resize(crop, (tw, th), interpolation=interp)
                im = Image.fromarray(crop)
                return ctk.CTkImage(light_image=im, size=(tw, th))
            except Exception as e:
                print(f"[ZOOM] render_zoom error: {e}")
                return None

        last_zoom_frame = None
        last_zoom_ts = -1

        zoom_after = {"id": None}

        def update_loop():
            nonlocal last_zoom_frame, last_zoom_ts
            if not zoom_win.winfo_exists() or not lbl.winfo_exists():
                return
            frame_rgb = None
            try:
                q = self.zoom_q; item = None
                while q is not None and not q.empty():
                    item = q.get_nowait()
                if item is not None:
                    try:
                        role2, payload, _ts = item
                    except Exception:
                        role2, _ts, payload = item
                    if role2 == role and payload is not None:
                        try:
                            ts_val = int(_ts)
                        except Exception:
                            ts_val = int(time.time() * 1e9)
                        if ts_val < last_zoom_ts:
                            ts_val = last_zoom_ts
                        if isinstance(payload, str):
                            got = self.smm.read_frame(payload)
                            if got is not None:
                                frame_rgb, _ = got if isinstance(got, tuple) else (got, 0)
                                if frame_rgb is not None:
                                    last_zoom_frame = frame_rgb
                                    last_zoom_ts = ts_val
                        elif isinstance(payload, np.ndarray):
                            frame_rgb = payload
                            last_zoom_frame = frame_rgb
                            last_zoom_ts = ts_val
            except Exception as e:
                print(f"[ZOOM] queue read error: {e}")
            if frame_rgb is None:
                frame_rgb = last_zoom_frame if last_zoom_frame is not None else self.fullres_frames.get(role)
            if frame_rgb is not None:
                img_ctk = render_zoom(frame_rgb)

                if img_ctk:
                    set_ctk_image(lbl, img_ctk)

            else:
                lbl.configure(text="âŹł brak klatek do zoomu (kolejka pusta)")
            zoom_after["id"] = zoom_win.after(33, update_loop)

        def on_zoom_close():
            aid = zoom_after.get("id")
            if aid:
                try:
                    zoom_win.after_cancel(aid)
                except Exception:
                    pass
                zoom_after["id"] = None
            try:
                if hasattr(self, "_zoom_windows"):
                    self._zoom_windows.pop(role, None)
            except Exception:
                pass
            try:
                if zoom_win.winfo_exists():
                    zoom_win.destroy()
            except Exception:
                pass

        zoom_win.protocol("WM_DELETE_WINDOW", on_zoom_close)
        update_loop()

    def _stop_blink(self, role: str):
        job = self._blink_jobs.pop(role, None)
        if job is not None:
            try:
                self.after_cancel(job)
            except Exception:
                pass
        self._blink_on[role] = False
        lbl = self.camera_info_labels.get(role)
        if lbl is not None:
            try:
                lbl.configure(text_color=TEXT_DIM)
            except Exception:
                pass

    def _blink_tick(self, role: str):
        if self._closing or not self.winfo_exists():
            return
        lbl = self.camera_info_labels.get(role)
        if lbl is None:
            return

        on = not self._blink_on.get(role, False)
        self._blink_on[role] = on

        try:
            lbl.configure(text_color=("red" if on else TEXT_DIM))
        except Exception:
            pass

        self._blink_jobs[role] = self._safe_after(350, lambda r=role: self._blink_tick(r))

    def _start_blink(self, role: str):
        if role in self._blink_jobs:
            return  # juĹĽ miga
        self._blink_on[role] = False
        self._blink_jobs[role] = self._safe_after(1, lambda r=role: self._blink_tick(r))

    def _update_blink_condition(self, role: str, fps, mbps):
        """
        mrugaj na czerwono gdy:
        - kamera "0" (fps/mbps ~ 0) lub brak danych
        - mocny spadek MB/s wzglÄ™dem normy (EMA)
        """
        try:
            fps_v = float(fps) if fps is not None else 0.0
        except Exception:
            fps_v = 0.0
        try:
            mbps_v = float(mbps) if mbps is not None else 0.0
        except Exception:
            mbps_v = 0.0

        # 1) twardy brak danych / rozĹ‚Ä…czenie
        if fps_v <= 0.1 or mbps_v <= 0.1:
            self._start_blink(role)
            return

        # 2) "spadek" wzglÄ™dem normy (EMA)
        ema = self._bw_ema.get(role)
        if ema is None:
            self._bw_ema[role] = mbps_v
            self._stop_blink(role)
            return

        # aktualizacja EMA tylko gdy mamy sensownÄ… wartoĹ›Ä‡
        alpha = 0.15
        ema = (1 - alpha) * float(ema) + alpha * mbps_v
        self._bw_ema[role] = ema

        # jeĹ›li spadĹ‚o mocno poniĹĽej normy â†’ mrugaj
        if ema > 1.0 and mbps_v < 0.6 * ema:
            self._start_blink(role)
        else:
            self._stop_blink(role)

    def on_yolo_imgsz_change(self, value):
        imgsz = int(float(value))

        if self._imgsz_after_id is not None:
            try:
                self.after_cancel(self._imgsz_after_id)
            except Exception:
                pass

        def _send():
            try:
                self.control_q.put(("yolo_set_image_size", imgsz))
            except Exception as e:
                print(f"[GUI] imgsz send error: {e}")

        self._imgsz_after_id = self._safe_after(250, _send)


def run_preview_app(live_q, roles, shared_state=None,
                    control_q=None, stats_q=None, init_settings=None, zoom_q=None, yolo_vis_q=None):
    app = PreviewGUI(
        live_q=live_q,
        roles=roles,
        shared_state=shared_state,
        control_q=control_q,
        stats_q=stats_q,
        init_settings=init_settings,
        zoom_q=zoom_q,
        yolo_vis_q=yolo_vis_q,
    )
    app.mainloop()

