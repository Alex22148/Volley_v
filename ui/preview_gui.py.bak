def set_ctk_image(widget, image_like, size=None):
    """
    Ustawia CTkImage na widget i trzyma referencjÄ™,
    ĹĽeby obraz nie znikaĹ‚ przez GC.
    """
    if isinstance(image_like, ctk.CTkImage):
        cimg = image_like
    elif isinstance(image_like, Image.Image):
        cimg = ctk.CTkImage(light_image=image_like, size=size or image_like.size)
    elif isinstance(image_like, np.ndarray):
        pil = Image.fromarray(image_like)
        cimg = ctk.CTkImage(light_image=pil, size=size or pil.size)
    else:
        return
    widget.configure(image=cimg, text="")
    widget.image = cimg  # trzymamy referencjÄ™


class PreviewGUI(ctk.CTk):
    def __init__(self, live_q, roles, shared_state=None, control_q=None,
                 stats_q=None, init_settings=None, zoom_q=None, yolo_vis_q=None):

        super().__init__()

        # --- AUTO ROZMIAR OKNA PREVIEW ---
        sw = self.winfo_screenwidth()
        sh = self.winfo_screenheight()

        # szerokoĹ›Ä‡ okna podglÄ…du = reszta ekranu obok panelu
        self._width = int(sw * 0.70)  # ~70% szerokoĹ›ci
        h = int(sh * 0.95)

        # ustawiamy wstÄ™pnie "obok" (spĂłjne z 0.28 w CaptureGUI)
        x = int(sw * 0.28) + int(sw * 0.015)  # maĹ‚y odstÄ™p
        y = int(sh * 0.02)

        self.geometry(f"{self._width}x{h}+{x}+{y}")

        self.live_q = live_q
        self.roles = list(roles or [])
        self.shared_state = shared_state
        self.control_q = control_q
        self.stats_q = stats_q
        self.initial_settings = init_settings or {}
        self.zoom_q = zoom_q or queue.Queue(maxsize=8)
        self.yolo_vis_q = yolo_vis_q
        self.yolo_centers = {role: None for role in self.roles}
        self.show_yolo_center_var = ctk.BooleanVar(value=True)
        self.preview_mode_var = ctk.StringVar(value="Operator mode")
        self._after_ids = set()
        self._tuning_boxes = {}
        # per-kamera UI / stan
        self.camera_labels = {}
        self.preview_frames = {}      # đź”ą DODANE: rola -> ramka preview
        self.fullres_frames = {}
        self._imgsz_after_id = None
        self.smm = get_shared_memory_manager()
        self._closing = False
        # đź”ą Placeholder â€“ peĹ‚ny obraz PNG "kamera rozĹ‚Ä…czona"
        try:
            try:
                # jeĹ›li masz resource_path przy PyInstallerze:
                img_path = resource_path("images//no_signal1.png")
                self.no_signal_pil = Image.open(img_path).convert("RGBA")
            except Exception:
                # dla wersji z konsoli / dev
                print("nie udaĹ‚o się wczytaÄ‡ obrazka")

        except Exception as e:
            print(f"[PREVIEW] âš ď¸Ź nie udaĹ‚o się wczytaÄ‡ {e}")
            self.no_signal_pil = None

        # per-kamera UI / stan
        self.camera_labels = {}
        self.fullres_frames = {}
        self.sliders = {}
        self.eff_bars = {}
        self.eff_labels = {}
        self._save_stats_buffer = {}
        self._cam_info = {}  # role -> (model, fw, serial)

        self._bandwidth = {}  # role -> {"fps":..., "pc_MBps":...}
        self._bw_last_time = {r: 0.0 for r in self.roles}  # role -> time.time()

        self._blink_jobs = {}  # role -> after_id
        self._blink_on = {}  # role -> bool (stan migania)
        self._bw_ema = {}  # role -> wygĹ‚adzona przepustowoĹ›Ä‡ MB/s

        # nowe: etykiety z informacjÄ… o kamerze (model/FW/SN) per rola
        self.camera_info_labels = {}

        # kiedy ostatnio dostaliĹ›my klatkÄ™ dla danej roli
        self._last_frame_time = {r: 0.0 for r in self.roles}
        self._preview_active_last = False
        # ostatnie komunikaty z watchdoga per rola
        self._watchdog_msgs = {}   # role -> ostatni tekst "[WATCHDOG] ..."
        self.title("VolleyHub â€“ PodglÄ…d")
        self.configure(fg_color=BG_LIGHT)

        self._build_main_ui()
        self.protocol("WM_DELETE_WINDOW", self.on_close)

        # pÄ™tle
        self._safe_after(80, self.update_frames)
        self._safe_after(30, self._poll_yolo_vis)
        self._safe_after(250, self._bandwidth_watchdog)

        if self.stats_q is not None:
            self._safe_after(1000, self._update_stats)
            self._safe_after(3000, self._update_efficiency_bars)
        if self.shared_state is not None:
            self._safe_after(200, self._follow_main_window)
            self._safe_after(300, self._update_cam_status)


