async def api_frame(request: web.Request):
    """
    Zwraca JPEG bieĹĽÄ…cej ramki wybranej roli.
    NEW: opcjonalne skalowanie po stronie serwera przez query:
         ?out_w=<px>&out_h=<px>
    """
    # ĹşrĂłdĹ‚o prawdy: shared_state
    role = _shared_state.get("selected_role", "CENTER_L") if _shared_state else "CENTER_L"
    ck = _shared_state.get("current_key") if _shared_state else None
    key = ck.get(role) if ck is not None else None

    from storage.shared_memory_manager import get_shared_memory_manager
    smm = get_shared_memory_manager()

    if not key:
        return web.Response(status=204)

    data = smm.read_frame(key)
    if data is None:
        return web.Response(status=204)

    frame_bgr = data[0] if isinstance(data, tuple) else data


    try:
        out_w = int(request.query.get("out_w", "0") or 0)
        out_h = int(request.query.get("out_h", "0") or 0)
    except Exception:
        out_w = out_h = 0

    if out_w > 0 and out_h > 0:
        try:
            import cv2
            frame_bgr = cv2.resize(frame_bgr, (out_w, out_h), interpolation=cv2.INTER_AREA)
        except Exception:
            pass

    # --- kodowanie JPEG + nagĹ‚Ăłwki cache ---
    try:
        import cv2
        params = [
            int(cv2.IMWRITE_JPEG_QUALITY), 90,
            int(cv2.IMWRITE_JPEG_OPTIMIZE), 1
        ]
        ok, buf = cv2.imencode(".jpg", frame_bgr, params)
        if not ok:
            return web.Response(status=500, text="encode failed")
        return web.Response(
            body=buf.tobytes(),
            content_type="image/jpeg",
            headers={"Cache-Control": "no-store"}
        )
    except Exception:
        # fallback przez PIL
        from PIL import Image
        import io as _io
        img = Image.fromarray(frame_bgr[:, :, ::-1])  # BGR->RGB
        bio = _io.BytesIO()
        img.save(bio, format="JPEG", quality=90, optimize=True)
        return web.Response(
            body=bio.getvalue(),
            content_type="image/jpeg",
            headers={"Cache-Control": "no-store"}
        )






async def api_frame_roi(request: web.Request):
    """
    /api/roi?role=...&x=...&y=...&w=...&h=...&out_w=...&out_h=...
    x,y,w,h w [0..1] wzglÄ™dem PEĹNEJ klatki.
    Kolor liczony tylko dla wycinka (Bayer->BGR), CPU-friendly.
    """
    # --- rola ---
    role = request.query.get("role")
    if not role:
        role = _shared_state.get("selected_role", "CENTER_L") if _shared_state else "CENTER_L"

    # --- weĹş ostatni klucz do BAYER ---
    bkey_dict = _shared_state.get("bayer_key") if _shared_state else None
    bayer_key = bkey_dict.get(role) if bkey_dict is not None else None

    from storage.shared_memory_manager import get_shared_memory_manager
    smm = get_shared_memory_manager()

    # Fallback: jeĹ›li nie ma BAYER â†’ uĹĽyj aktualnej BGR (dziaĹ‚a, ale mniej efektywnie)
    if not bayer_key:
        ck = _shared_state.get("current_key") if _shared_state else None
        key = ck.get(role) if ck is not None else None
        if not key:
            return web.Response(status=204)
        data = smm.read_frame(key)
        if data is None:
            return web.Response(status=204)
        frame_bgr = data[0] if isinstance(data, tuple) else data
        H, W = frame_bgr.shape[:2]
        src_mode = "bgr"
    else:
        data = smm.read_frame(bayer_key)
        if data is None:
            return web.Response(status=204)
        bayer = data[0] if isinstance(data, tuple) else data
        H, W = bayer.shape[:2]
        src_mode = "bayer"

    # --- parsowanie ROI ---
    def _f(name, default):
        try:
            return float(request.query.get(name, default))
        except Exception:
            return float(default)

    nx = max(0.0, min(1.0, _f("x", 0.0)))
    ny = max(0.0, min(1.0, _f("y", 0.0)))
    nw = max(0.0, min(1.0, _f("w", 1.0)))
    nh = max(0.0, min(1.0, _f("h", 1.0)))
    if nx + nw > 1.0: nw = max(0.0, 1.0 - nx)
    if ny + nh > 1.0: nh = max(0.0, 1.0 - ny)

    import numpy as _np
    x0 = int(_np.floor(nx * W))
    y0 = int(_np.floor(ny * H))
    x1 = int(_np.ceil((nx + nw) * W))
    y1 = int(_np.ceil((ny + nh) * H))
    x0 = max(0, min(x0, W - 1))
    y0 = max(0, min(y0, H - 1))
    x1 = max(0, min(x1, W))
    y1 = max(0, min(y1, H))
    if x1 <= x0: x1 = min(W, x0 + 1)
    if y1 <= y0: y1 = min(H, y0 + 1)

    if src_mode == "bayer":
        crop_bayer = bayer[y0:y1, x0:x1]
        if crop_bayer.size == 0:
            return web.Response(status=204)
        import cv2
        crop_bgr = cv2.cvtColor(crop_bayer, cv2.COLOR_BAYER_RG2RGB)
        img = crop_bgr
    else:
        crop_bgr = frame_bgr[y0:y1, x0:x1]
        if crop_bgr is None or crop_bgr.size == 0:
            return web.Response(status=204)
        img = crop_bgr

    # opcjonalne skalowanie
    try:
        out_w = int(request.query.get("out_w", "0") or 0)
        out_h = int(request.query.get("out_h", "0") or 0)
    except Exception:
        out_w = out_h = 0

    if out_w > 0 and out_h > 0:
        try:
            import cv2
            interp = cv2.INTER_AREA if (out_w < img.shape[1] or out_h < img.shape[0]) else cv2.INTER_LINEAR
            img = cv2.resize(img, (out_w, out_h), interpolation=interp)
        except Exception:
            pass

    # JPEG out
    try:
        import cv2
        ok, buf = cv2.imencode(".jpg", img, [int(cv2.IMWRITE_JPEG_QUALITY), 90, int(cv2.IMWRITE_JPEG_OPTIMIZE), 1])
        if not ok:
            return web.Response(status=500, text="encode failed")
        return web.Response(body=buf.tobytes(), content_type="image/jpeg", headers={"Cache-Control": "no-store"})
    except Exception:
        from PIL import Image
        import io as _io
        im = Image.fromarray(img[:, :, ::-1])  # BGR->RGB
        bio = _io.BytesIO()
        im.save(bio, format="JPEG", quality=90, optimize=True)
        return web.Response(body=bio.getvalue(), content_type="image/jpeg", headers={"Cache-Control": "no-store"})


async def api_yolo_stats(request: web.Request):
    """Zwraca statystyki YOLO"""
    try:
        from vision.yolo_module import get_yolo_stats
        stats = get_yolo_stats()
        return web.json_response({"ok": True, "stats": stats})
