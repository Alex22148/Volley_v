# --- ZAMIANA: bazuj na resource_path zamiast __file__
from pathlib import Path
_BASE_DIR = Path(resource_path(""))            # katalog obok exe
_WWW_DIR = _BASE_DIR                           # index.html
_STATIC_DIR = _BASE_DIR                        # app.js obok exe
_ALT_STATIC_DIR = _BASE_DIR / "static"         # ewentualnie dist/VolleyHub/static/
 # app.js w ./static/app.js

async def offer(request: web.Request):
    params = await request.json()
    pc = RTCPeerConnection()
    pcs.add(pc)

    pc.addTrack(BaslerTrack())

    offer_obj = RTCSessionDescription(params["sdp"], params["type"])
    await pc.setRemoteDescription(offer_obj)
    answer = await pc.createAnswer()
    await pc.setLocalDescription(answer)

    return web.json_response({"sdp": pc.localDescription.sdp, "type": pc.localDescription.type})



from aiohttp import web
from pathlib import Path

async def index(request: web.Request):
    p = Path(resource_path("index.html"))
    print(p)
    print("index")
    if p.exists():
        return web.FileResponse(p)
    raise web.HTTPNotFound(text="index.html not found on disk")


async def static_appjs(request: web.Request):
    print("static_appjs")
    p = Path(resource_path("app.js"))
    print(p)
    if p.exists():
        return web.FileResponse(p)

    alt = _ALT_STATIC_DIR / "app.js"
    if alt.exists():
        return web.FileResponse(alt)

    raise web.HTTPNotFound(text="app.js not found (static_appjs)")


async def app_js(request: web.Request):
    print("app_js")
    p = Path(resource_path("app.js"))
    print(p)
    if p.exists():
        return web.FileResponse(p)

    alt = _ALT_STATIC_DIR / "app.js"
    if alt.exists():
        return web.FileResponse(alt)

    raise web.HTTPNotFound(text="app.js not found (app_js)")



async def api_roles(request: web.Request):
    roles = []
    if _shared_state is not None:
        try:
            roles = list(_shared_state.get("roles", []))
        except Exception:
            roles = []
    sel = "CENTER_L"
    if _shared_state is not None:
        try:
            sel = _shared_state.get("selected_role", "CENTER_L")
        except Exception:
            pass
    return web.json_response({"roles": roles, "selected": sel})


async def api_select_camera(request: web.Request):
    data = await request.json()
    role = str(data.get("role", "")).strip()
    if not role:
        return web.json_response({"ok": False, "err": "missing role"}, status=400)
    # 1) zapis do shared_state â€“ to jest jedyne ĹşrĂłdĹ‚o prawdy
    if _shared_state is not None:
        _shared_state["selected_role"] = role
    # 2) opcjonalnie ustaw lokalny Value jeĹ›li istnieje (w tym procesie zwykle i tak jest None)
    try:
        set_selected_role(role)
    except Exception:
        pass
    print("[API] selected_role set to:", role)
    return web.json_response({"ok": True, "selected": role})

async def api_exposure(request: web.Request):
    # body: {"role": "...", "value": <float/int microseconds>}
    try:
        data = await request.json()
        role = str(data.get("role"))
        val = float(data.get("value"))
        cq = _control_q
        if cq is None:
            try:
                import core.utils_config as utils_config
                cq = getattr(utils_config, "control_q", None)
            except Exception:
                cq = None
        if cq is None:
            return web.json_response({"ok": False, "err": "control_q not available"}, status=503)
        cq.put(("set_exposure", (role, val)))
        return web.json_response({"ok": True})
    except Exception as e:
        return web.json_response({"ok": False, "err": str(e)}, status=400)

