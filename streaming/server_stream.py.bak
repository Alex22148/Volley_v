async def api_yolo_toggle(request: web.Request):
    """WĹ‚Ä…cza/wyĹ‚Ä…cza YOLO"""
    try:
        data = await request.json()
        enabled = bool(data.get("enabled", False))
        
        cq = _control_q
        if cq is None:
            try:
                import core.utils_config as utils_config
                cq = getattr(utils_config, "control_q", None)
            except Exception:
                cq = None
        if cq is None:
            return web.json_response({"ok": False, "error": "control_q not available"}, status=503)
            
        cq.put(("yolo", enabled))
        return web.json_response({"ok": True, "enabled": enabled})
    except Exception as e:
        return web.json_response({"ok": False, "error": str(e)}, status=400)

