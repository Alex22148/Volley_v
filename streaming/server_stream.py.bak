async def api_yolo_set_preprocess_backend(request: web.Request):
    """Ustawia backend preprocessu YOLO (cpu/cuda)"""
    try:
        data = await request.json()
        backend = str(data.get("backend", "cpu")).strip().lower()
        if backend not in ("cpu", "cuda"):
            return web.json_response({"ok": False, "error": "backend must be cpu or cuda"}, status=400)

        cq = _control_q
        if cq is None:
            try:
                import core.utils_config as utils_config
                cq = getattr(utils_config, "control_q", None)
            except Exception:
                cq = None
        if cq is None:
            return web.json_response({"ok": False, "error": "control_q not available"}, status=503)

        cq.put(("yolo_set_preprocess_backend", backend))
        return web.json_response({"ok": True, "backend": backend})
    except Exception as e:
        return web.json_response({"ok": False, "error": str(e)}, status=400)

async def healthz(request: web.Request):
    return web.json_response({"ok": True})

def _make_app():
    app = web.Application()
    app.on_shutdown.append(_on_shutdown)
    # signalling
    app.router.add_post("/offer", offer)
    # statics + index
    app.router.add_get("/", index)
    app.router.add_get("/index.html", index)
    app.router.add_get("/static/app.js", static_appjs)
    app.router.add_get("/app.js", app_js)
    # API
    app.router.add_get("/api/roles", api_roles)
    app.router.add_post("/api/select_camera", api_select_camera)
    app.router.add_post("/api/exposure", api_exposure)
    app.router.add_post("/api/gain", api_gain)
    app.router.add_get("/api/frame", api_frame)
    app.router.add_get("/api/roi", api_frame_roi)
    # YOLO API
    app.router.add_get("/api/yolo/stats", api_yolo_stats)
    app.router.add_post("/api/yolo/toggle", api_yolo_toggle)
    app.router.add_post("/api/yolo/load_model", api_yolo_load_model)
    app.router.add_post("/api/yolo/set_class_id", api_yolo_set_class_id)
    app.router.add_post("/api/yolo/set_confidence", api_yolo_set_confidence)
    app.router.add_post("/api/yolo/set_image_size", api_yolo_set_image_size)
    app.router.add_post("/api/yolo/set_device", api_yolo_set_device)
    app.router.add_post("/api/yolo/set_preprocess_backend", api_yolo_set_preprocess_backend)
    app.router.add_get("/healthz", healthz)
    return app

async def _on_shutdown(app):
    for pc in pcs:
        await pc.close()
    pcs.clear()

def _run_webrtc(port: int, shared_state_arg=None, control_q_arg=None):
    if shared_state_arg is not None:
        global _shared_state, _current_frame_key, _control_q
        _shared_state = shared_state_arg
        _current_frame_key = _shared_state.get("current_key") if _shared_state else None
        _control_q = control_q_arg

        try:
            _current_frame_key = _shared_state.get("current_key")
        except Exception:
            _current_frame_key = None
    app = _make_app()
    print(f"[WebRTC] signalling on :{port}")
    web.run_app(app, port=port)


# ----------------------------
#  Start/Stop serwera
# ----------------------------
def start_webrtc_server(port: int = 8765, manager=None, shared_state=None, control_q=None):
    """
    Startuje WebRTC jeĹ›li nie dziaĹ‚a. JeĹ›li dziaĹ‚a â€“ NIE tworzy nowego procesu,
    tylko aktualizuje URL w shared_state.
    """
    global _webrtc_proc, _shared_state

    # --- 1) JeĹ›li proces juĹĽ dziaĹ‚a â†’ tylko odĹ›wieĹĽ URL ---
    if _webrtc_proc is not None and _webrtc_proc.is_alive():
        try:
            host_ip = _get_host_ip()
            url = f"http://{host_ip}:{port}"
            if shared_state is not None:
                shared_state["remote_url"] = url
            print(f"[CTRL] đźŚ WebRTC running at {url}")
            return url
        except Exception:
            return None

    # --- 2) Inicjalizacja wspĂłĹ‚dzielonego stanu ---
    init_shared(manager=manager, shared_state=shared_state)

    # --- 3) Uruchom nowy proces ---
    _webrtc_proc = mp.Process(
        target=_run_webrtc,
        args=(port, _shared_state, control_q),
        daemon=False
    )
    _webrtc_proc.start()
    print(f"[WebRTC] started pid={_webrtc_proc.pid}")

    # --- 4) Wylicz i zapisz URL ---
    try:
        host_ip = _get_host_ip()
        url = f"http://{host_ip}:{port}"
        if _shared_state is not None:
            _shared_state["remote_url"] = url
        print(f"[CTRL] đźŚ WebRTC running at {url}")
        return url
    except Exception:
        return None

# (opcjonalne) twarde ubijanie dzieci dla cleanupu
def kill_child_processes():
    try:
        pid = os.getpid()
        if os.name == "nt":
            # na Windowsie pozostawiamy terminate() dzieci (robione wyĹĽej)
            return
        import psutil as _ps
        p = _ps.Process(pid)
        for ch in p.children(recursive=True):
            try:
                ch.send_signal(signal.SIGTERM)
            except Exception:
                pass
    except Exception:
        pass

def stop_webrtc_server():
    global _webrtc_proc
    if _webrtc_proc is not None:
        if _webrtc_proc.is_alive():
            print(f"[WebRTC] stopping pid={_webrtc_proc.pid}")
            _webrtc_proc.terminate()
            _webrtc_proc.join(timeout=2.0)
        _webrtc_proc = None
    if _shared_state is not None:
        _shared_state["remote_url"] = None
    print("[WebRTC] stopped")




